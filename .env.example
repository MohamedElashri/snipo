# Copy to .env, replace placeholders, and keep the file out of version control.

# Authentication: choose a plaintext password or an Argon2id hash.
# Generate a hash interactively with: ./snipo hash-password
SNIPO_MASTER_PASSWORD=replace-with-a-strong-unique-password
# SNIPO_MASTER_PASSWORD_HASH='$argon2id$...'

# Set stable random values before first use.
# Generate with: openssl rand -hex 32
SNIPO_SESSION_SECRET=replace-with-a-random-session-secret
# Generate with: openssl rand -base64 32
SNIPO_ENCRYPTION_SALT=replace-with-a-random-encryption-salt
SNIPO_SESSION_DURATION=168h

# SNIPO_DISABLE_AUTH bypasses every Snipo authentication check. Read
# SECURITY.md before enabling it.
# SNIPO_DISABLE_AUTH=false

# Server
SNIPO_HOST=0.0.0.0
SNIPO_PORT=8080
SNIPO_READ_TIMEOUT=30s
SNIPO_WRITE_TIMEOUT=30s
SNIPO_TRUST_PROXY=false
# SNIPO_BASE_PATH=/snipo
SNIPO_MAX_FILES_PER_SNIPPET=10

# SQLite
SNIPO_DB_PATH=/data/snipo.db
SNIPO_DB_MAX_CONNS=1
SNIPO_DB_BUSY_TIMEOUT=5000
SNIPO_DB_JOURNAL=WAL
SNIPO_DB_SYNC=NORMAL
SNIPO_DB_MMAP_SIZE=268435456
SNIPO_DB_CACHE_SIZE=-2000

# Login and API rate limits
SNIPO_RATE_LIMIT=100
SNIPO_RATE_LIMIT_READ=1000
SNIPO_RATE_LIMIT_WRITE=500
SNIPO_RATE_LIMIT_ADMIN=100

# Empty means same-origin. Use exact comma-separated origins when needed.
SNIPO_ALLOWED_ORIGINS=

# Feature flags
SNIPO_ENABLE_PUBLIC_SNIPPETS=true
SNIPO_ENABLE_API_TOKENS=true
SNIPO_ENABLE_BACKUP_RESTORE=true

# S3-compatible backup storage
SNIPO_S3_ENABLED=false
SNIPO_S3_ENDPOINT=
SNIPO_S3_ACCESS_KEY=
SNIPO_S3_SECRET_KEY=
SNIPO_S3_BUCKET=
SNIPO_S3_REGION=us-east-1
SNIPO_S3_SSL=true

# Logging
SNIPO_LOG_LEVEL=info
SNIPO_LOG_FORMAT=json

# Demo mode resets its database, uses a fixed password, and disables API key
# creation and GitHub Gist sync for security. Never use it for real data or a
# production deployment.
# SNIPO_DEMO_MODE=false
# SNIPO_DEMO_RESET_INTERVAL=15m
